{
  "name": "calypto-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write app components lib prisma/seed.mjs",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "admin:promote": "node prisma/admin-role.mjs promote",
    "admin:demote": "node prisma/admin-role.mjs demote"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@prisma/client": "^6.19.3",
    "aos": "^2.3.4",
    "bcrypt": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aos": "^3.0.8",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "braces": "^3.0.3",
    "deepmerge-ts": "^8.0.0",
    "eslint-config-next": {
      "@next/eslint-plugin-next": {
        "fast-glob": {
          "micromatch": {
            "braces": "^3.0.3"
          }
        }
      }
    }
