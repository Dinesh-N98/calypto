generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum CrmInteractionType {
  NOTE
  CALL
  EMAIL
  MEETING
  OTHER
}

enum PaymentProvider {
  STRIPE
  ONEPAY
  PAYPAL
}

enum NewsletterSubscriptionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  UNSUBSCRIBED
}

enum NewsletterDiscountLookupStatus {
  VALID
  ALREADY_REDEEMED
  NOT_FOUND
  INELIGIBLE
}

model Product {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  name                   String
  description            String
  brand                  String?
  priceCents             Int
  salePriceCents         Int?
  originalPriceCents     Int?
  saleEndsAt             DateTime?
  tieredDiscountsEnabled Boolean?
  categoryId             String
  category               Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imageUrl               String
  createdAt              DateTime         @default(now())
  wishlistItems          WishlistItem[]
  variants               ProductVariant[]
  images                 ProductImage[]
  reviews                Review[]
  tieredDiscounts        TieredDiscount[]

  @@index([categoryId])
  @@index([saleEndsAt])
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sku                String   @unique
  priceCents         Int
  discountPriceCents Int?
  stock              Int      @default(0)
  size               String?
  color              String?
  imageUrl           String?
  createdAt          DateTime @default(now())

  @@index([productId, stock])
  @@index([productId, size, color])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  url       String
  order     Int      @default(0)
  altText   String?
  createdAt DateTime @default(now())

  @@unique([productId, order])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model TieredDiscount {
  id                 String  @id @default(cuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  minQuantity        Int
  discountPercentage Int

  @@unique([productId, minQuantity])
}

model Category {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  image                  String?
  displayOrder           Int       @default(0)
  tieredDiscountsEnabled Boolean   @default(false)
  createdAt              DateTime  @default(now())
  products               Product[]
}

model Promotion {
  id                  String    @id @default(cuid())
  title               String
  description         String
  imageUrl            String
  discountType        String    @default("percentage")
  discountPercent     Int?
  discountAmountCents Int?
  discountCode        String?
  isActive            Boolean   @default(true)
  startDate           DateTime? @db.Timestamp(3)
  endDate             DateTime? @db.Timestamp(3)
  createdAt           DateTime  @default(now()) @db.Timestamp(3)
  updatedAt           DateTime  @updatedAt @db.Timestamp(3)

  @@index([isActive, startDate, endDate])
}

model Lead {
  id                      String                          @id @default(cuid())
  type                    String
  name                    String
  email                   String?
  phone                   String?
  company                 String?
  country                 String?
  city                    String?
  state                   String?
  address                 String?
  website                 String?
  message                 String
  discountCode            String?
  discountCodeStatus      NewsletterDiscountLookupStatus?
  discountSubscriberEmail String?
  discountPercent         Int?
  notes                   String?
  status                  LeadStatus                      @default(NEW)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  interactions            CrmInteraction[]

  @@index([status, updatedAt])
}

model NewsletterSubscription {
  id                    String                        @id @default(cuid())
  email                 String                        @unique
  status                NewsletterSubscriptionStatus  @default(PENDING_CONFIRMATION)
  source                String
  consentText           String                        @db.Text
  consentVersion        String
  consentAt             DateTime
  confirmationTokenHash String?                       @unique
  confirmationSentAt    DateTime?
  confirmedAt           DateTime?
  unsubscribeTokenHash  String?                       @unique
  unsubscribedAt        DateTime?
  discountCode          String?                       @unique
  discountPercent       Int                           @default(15)
  discountRedeemedAt    DateTime?
  redeemedOrderId       String?
  redemption            NewsletterDiscountRedemption?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([status])
}

model NewsletterDiscountRedemption {
  id               String                 @id @default(cuid())
  subscriptionId   String                 @unique
  subscription     NewsletterSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  redeemedByUserId String
  redeemedBy       User                   @relation(fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  redeemedAt       DateTime               @default(now())
  orderReference   String?
  note             String?                @db.Text

  @@index([redeemedByUserId, redeemedAt])
}

model User {
  id                            String                         @id @default(cuid())
  name                          String?
  firstName                     String?
  lastName                      String?
  email                         String                         @unique
  role                          UserRole                       @default(CUSTOMER)
  emailVerified                 DateTime?
  image                         String?
  hashedPassword                String?
  address                       String?
  phone                         String?
  accounts                      Account[]
  sessions                      Session[]
  orders                        Order[]
  addresses                     Address[]
  wishlistItems                 WishlistItem[]
  authoredCrmInteractions       CrmInteraction[]               @relation("CrmInteractionAuthor")
  crmInteractions               CrmInteraction[]               @relation("CrmInteractionCustomer")
  newsletterDiscountRedemptions NewsletterDiscountRedemption[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isDefault])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Order {
  id                    String           @id @default(cuid())
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id])
  email                 String
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  shippingName          String?
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingState         String?
  shippingPostalCode    String?
  shippingCountry       String?
  paymentProvider       PaymentProvider
  providerReference     String           @unique
  providerTransactionId String?          @unique
  totalCents            Int
  currency              String
  status                String           @default("pending")
  fulfillmentStatus     String?
  carrier               String?
  trackingNumber        String?
  trackingUrl           String?
  items                 OrderItem[]
  paymentAttempts       PaymentAttempt[]
  crmInteractions       CrmInteraction[]
  createdAt             DateTime         @default(now())
}

model CrmInteraction {
  id         String             @id @default(cuid())
  type       CrmInteractionType @default(NOTE)
  subject    String?
  content    String             @db.Text
  occurredAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  authorId   String
  author     User               @relation("CrmInteractionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  customerId String?
  customer   User?              @relation("CrmInteractionCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([orderId, occurredAt])
}

model PaymentAttempt {
  id                    String          @id @default(cuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                String          @default("pending")
  amountCents           Int
  currency              String
  idempotencyKey        String          @unique
  requestHash           String
  captureRequestId      String          @unique
  providerOrderId       String?         @unique
  providerCaptureId     String?         @unique
  providerTransactionId String?         @unique
  refundedAmountCents  Int             @default(0)
  metadata              Json?
  expiresAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, status])
  @@index([provider, status, expiresAt])
}

model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  status          String          @default("received")
  payloadHash     String?

  @@unique([provider, providerEventId])
  @@index([provider, eventType, receivedAt])
}

model ApiRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productSlug String
  variantId   String?
  sku         String?
  name        String
  priceCents  Int
  quantity    Int
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  token      String   @unique
  expires    DateTime
  identifier String

  @@id([identifier, token])
}
